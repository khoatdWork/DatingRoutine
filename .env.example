# Run npm run setup first. Choose data and hosting independently in project.config.json.
# Only fill public client configuration for the chosen data provider.
# Never put a Supabase service_role/secret key or Firebase service account here.
# Firebase (dataProvider = firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Supabase (dataProvider = supabase): prefer the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key (leave empty when using publishable key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Empty on localhost/custom domain; /repository-name on GitHub project Pages.
NEXT_PUBLIC_BASE_PATH=
