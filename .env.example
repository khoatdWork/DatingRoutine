# Public browser configuration only. Copy to .env.local (ignored by Git).
# Never put Supabase secret/service_role or Cloudinary API Secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative; leave empty when using publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Empty for root localhost; /DatingRoutine for production preview.
NEXT_PUBLIC_BASE_PATH=
# Cloudinary settings live ONLY in Supabase Edge Function secrets.
# See docs/cloudinary.md. No NEXT_PUBLIC_CLOUDINARY_* variables are needed.
