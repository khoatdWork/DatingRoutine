{
  "name": "web-mobile-pwa-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-pwa.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:db": "firebase emulators:exec --only firestore --project demo-pwa-template \"vitest run tests/database\"",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "firebase": "13.2.0",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "15.35.0",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
