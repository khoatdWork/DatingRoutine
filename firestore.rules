rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/workspaces/default {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['version', 'snapshot', 'updatedAt'])
          && d.version is int && d.version > 0
          && d.updatedAt == request.time
          && d.snapshot is map
          && d.snapshot.keys().hasOnly(['schemaVersion', 'profile', 'notes'])
          && d.snapshot.schemaVersion == 1
          && d.snapshot.profile is map
          && d.snapshot.profile.keys().hasOnly(['displayName'])
          && d.snapshot.profile.displayName is string && d.snapshot.profile.displayName.size() <= 60
          && d.snapshot.notes is list && d.snapshot.notes.size() <= 500;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.version == 1;
      allow update: if owner() && valid() && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
